# Email Service (Resend API)
# Get your API key from: https://resend.com/api-keys
#
# IMPORTANT: this site sends from its own subdomain, separate from taglere.com.
# Verify `updates.ibuybaypark.com` in Resend (add the SPF + DKIM records it gives
# you to the ibuybaypark.com DNS zone) before the first send will succeed.
RESEND_API_KEY=your_resend_api_key_here

# Google Places API (address autocomplete on the offer form)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable the Places API: https://console.cloud.google.com/apis/library/places-backend.googleapis.com
# The same key used on taglere.com works here. Autocomplete results are biased
# toward Bay Park; the field degrades to a plain text input when this is unset.
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# HubSpot CRM Integration
# Get your access token from: https://app.hubspot.com/settings/account/security
# Create a private app with contacts and notes permissions.
# Leads from this site land with lead_source = "Website - ibuybaypark.com Cash Offer"
# so they stay separable from taglere.com leads.
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Google Analytics 4 (optional)
# Nothing is loaded and no cookies are set while this is unset.
# When set, a `generate_lead` event fires on each successful offer request.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
